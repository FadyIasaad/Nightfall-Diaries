  "timezone": "Africa/Cairo",
  "video": {
    "width": 720,
    "height": 1280,
    "fps": 24,
    "min_seconds": 35,
    "max_seconds": 60
  },
  "series": {
    "minimum_episodes": 10,
    "maximum_episodes": 12,
