      "facebook": "DRAFT",
      "tiktok": "inbox"
    },
    "allow_public_only_with_secret": "DRAMA_ALLOW_UNREVIEWED_PUBLIC",
    "ambiguous_uploads": "pause_and_reconcile_never_blind_retry",
    "advance_when_at_least_one_staged": true
  }
