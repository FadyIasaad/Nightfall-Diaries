    "new_series_requires_model": false
  },
  "trends": {
    "geo": [
      "US",
      "GB",
      "CA",
      "AU",
      "IN"
    ],
    "history_days": 7,
    "minimum_verified_entries": 1,
    "fetch_timeout_seconds": 12
  },
  "platform_modes": {
    "youtube": "public",
    "facebook": "PUBLISHED",
    "tiktok": "inbox"
  },
  "publish_unreviewed": true,
  "media_mode": "original_illustrated_cinematic_fantasy_cpu",
  "notes": "V4.1: manual button and 10 AM Cairo schedule generate + upload by default. Public YouTube/Meta only with DRAMA_ALLOW_UNREVIEWED_PUBLIC=true, otherwise private/draft. TikTok inbox until separately approved Direct Post and creator consent. Never promise public visibility without API verification.",
  "upload_policy": {
    "default_action": "generate_and_upload",
    "when_public_not_authorized": {
